@page
@model IndexModel
@{ ViewData["Title"] = "Início"; }
<h1>O que você quer produzir?</h1>
<section aria-label="Áreas de trabalho" class="area-grid">
    @foreach (var area in Workbench.Areas)
    {
        <article class="area-tile">
            <h2><a asp-page="/Area" asp-route-area="@area.Key">@area.Value</a></h2>
            <div class="tile-actions">
                @foreach (var mode in Workbench.Modes(area.Key).Take(2))
                { <a asp-page="/Area" asp-route-area="@area.Key" asp-route-mode="@mode.Key">@mode.Value <span aria-hidden="true">↗</span></a> }
            </div>
        </article>
    }
    <article class="area-tile"><h2><a asp-page="/Recursos">Contas e recursos</a></h2>
        <div class="tile-actions"><a asp-page="/Recursos">Ver conexões, cotas e custos <span aria-hidden="true">↗</span></a></div>
    </article>
</section>
<section class="resume-strip">
    <h2>Continuar de onde parei</h2>
    @if (Model.Recent.Count == 0) { <p class="muted">Abra um trabalho em uma das áreas acima para começar.</p> }
    <ul class="list">@foreach (var item in Model.Recent) {
        <li><a asp-page="/Trabalho" asp-route-id="@item.Id">@item.Title</a>
            <small>@Workbench.Areas[item.Area] · @TrabalhoModel.StateLabel(item.State)</small></li>
    }</ul>
</section>
<div class="grid">
    <section class="panel">
        <h2>Seus projetos</h2>
        @if (Model.Projects.Count == 0) { <p class="muted">Crie um projeto para registrar a primeira entrada.</p> }
        <ul class="list">
        @foreach (var project in Model.Projects)
        {
            <li><a asp-page="/Projeto" asp-route-id="@project.Id">@project.Name</a> <small>@project.Kind · @project.Classification</small></li>
        }
        </ul>
    </section>
    <section class="panel">
        <h2>Novo projeto</h2>
        @if (Model.Error != null) { <p class="alert" role="alert">@Model.Error</p> }
        <form method="post">
            <input type="hidden" name="key" value="@Model.Key">
            <label>Nome<input name="name" maxlength="100" required autofocus></label>
            <label>Tipo<select name="kind"><option value="software">Software</option><option value="estudio">Estúdio</option><option value="pesquisa">Pesquisa</option></select></label>
            <label>Classificação<select name="classification"><option value="interno">Interno</option><option value="publico">Público</option><option value="restrito">Restrito</option></select></label>
            <button>Criar projeto</button>
        </form>
    </section>
</div>
