<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Version>0.3.17</Version>
    <Product>Orbita Studio</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <ProjectReference Include="../Orbita.Core/Orbita.Core.csproj" />
    <ProjectReference Include="../Orbita.Pool/Orbita.Pool.csproj" />
    <ProjectReference Include="../Orbita.Engine/Orbita.Engine.csproj" />
    <Content Include="../CentralIA/AntigravityPool/*" Exclude="../CentralIA/AntigravityPool/*.test.mjs"
             Link="AntigravityPool/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
