<Window x:Class="Orbita.Desktop.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edge="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Orbita Studio" Width="1360" Height="850" MinWidth="760" MinHeight="520"
        Background="#13161B" WindowStartupLocation="CenterScreen">
    <Grid>
        <edge:WebView2 x:Name="WorkspaceView" Visibility="Hidden" />
        <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="580">
            <TextBlock Text="Orbita Studio" Foreground="#EFF3F9" FontFamily="Segoe UI Variable" FontWeight="SemiBold" FontSize="24" />
            <TextBlock x:Name="StatusText" Text="Abrindo o workspace…" Foreground="#B3C5DB" FontSize="14" Margin="0,10,0,14" TextWrapping="Wrap" />
            <Button x:Name="BrowserButton" Content="Abrir no navegador" Click="OpenBrowser" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,6" />
        </StackPanel>
    </Grid>
</Window>
